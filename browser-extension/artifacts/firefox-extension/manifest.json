{
  "manifest_version": 2,
  "name": "rget",
  "version": "0.1.0",
  "description": "Send downloads to the rget download manager",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "tabs",
    "contextMenus",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "rget"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rget@example.com",
      "strict_min_version": "109.0"
    }
  }
}